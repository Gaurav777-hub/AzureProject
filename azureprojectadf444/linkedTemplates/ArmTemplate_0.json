{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "azureprojectadf444"
		},
		"AzureProject_ADLS_Storage_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureProject_ADLS_Storage'"
		},
		"AzureProject_ADLS_Storage_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsstorage44.dfs.core.windows.net/"
		},
		"AzureProject_kv_ls_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://azureprojectkeyvs.vault.azure.net/"
		},
		"AzureProject_Databricks_ls_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "0925-174611-rd1z6gme"
		},
		"AzureSqlDatabase_ls_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "azureprojectsqlserver.database.windows.net"
		},
		"AzureSqlDatabase_ls_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AzureProjectSQLDB"
		},
		"AzureSqlDatabase_ls_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "azure-sql-user"
